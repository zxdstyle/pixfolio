{{ define "index.tmpl" }}
<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>Goravel</title>

        {{range $path := .scriptPath}}
        <script type="module" crossorigin src="{{$path}}"></script>
        {{end}}

        {{range $path := .cssPath}}
